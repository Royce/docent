{
	"name": "docent",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^22.13.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "HOST=localhost PORT=${DOCENT_PORT:-17321} BODY_SIZE_LIMIT=20M node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24.13.6",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@ai-sdk/mcp": "^2.0.80",
		"@ai-sdk/openai-compatible": "^3.0.74",
		"@floating-ui/dom": "^1.8.0",
		"@modelcontextprotocol/sdk": "^1.30.1",
		"ai": "^7.0.146",
		"diff": "^9.0.0",
		"dompurify": "^3.4.15",
		"marked": "^18.0.13",
		"shiki": "^4.4.3",
		"unique-names-generator": "^4.7.1",
		"zod": "^4.6.5"
	}
}
